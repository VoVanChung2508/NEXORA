      "regex": "^/invite/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/invite/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
